{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	# [PERF] the default list leaves out binary models: the .glb copies (Dockerfile) are compressed too
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
			header Content-Type model/gltf-binary*
		}
	}
	@glb path *.glb
	header @glb Content-Type "model/gltf-binary"
	# Always revalidate so every push is visible at once (ETag keeps it cheap).
	header Cache-Control "no-cache"
	header /version.txt Cache-Control "no-store"
	@txt path *.txt
	header @txt Content-Type "text/plain; charset=utf-8"
	file_server
}
